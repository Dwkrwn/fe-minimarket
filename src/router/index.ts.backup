// Navigation guard untuk authentication
router.beforeEach((to, from, next) => {
  const authStore = useAuthStore()
  
  // Check if user has valid session
  authStore.checkAuth()
  
  const requiresAuth = to.matched.some(record => record.meta.requiresAuth)
  const requiresSuperAdmin = to.matched.some(record => record.meta.requiresSuperAdmin)
  const isAuthenticated = authStore.isAuthenticated

  if (requiresAuth && !isAuthenticated) {
    // Redirect to login if trying to access protected route
    next({ name: 'Login' })
  } else if (requiresSuperAdmin && !authStore.isSuperAdmin) {
    // Redirect to dashboard if trying to access SUPER ADMIN only route
    next({ name: 'Dashboard' })
  } else if (to.name === 'Login' && isAuthenticated) {
    // Redirect to dashboard if already logged in and trying to access login
    next({ name: 'Dashboard' })
  } else if (requiresAuth && isAuthenticated && !authStore.isSuperAdmin) {
    // For regular users, check if they have access to this route based on SelectRespo
    // Skip check for certain routes: login, dashboard, notifikasi
    const publicRoutes = ['Login', 'Dashboard', 'Notifikasi', 'NotifikasiDetail', 'NotifikasiItemDetail']
    
    if (!publicRoutes.includes(to.name as string)) {
      // Get SelectRespo from localStorage
      const selectRespoData = localStorage.getItem('SelectRespo')
      
      if (selectRespoData) {
        try {
          const selectRespo = JSON.parse(selectRespoData)
          const userMenus = selectRespo.menus || []
          
          // Check if user has access to this route
          let hasAccess = userMenus.some((menu: any) => {
            // Check exact path match or parent path match (for form/view routes)
            return to.path === menu.path || to.path.startsWith(menu.path + '/')
          })
          
          // If no direct access found, check if route has a parentMenu meta
          // For example: /setup/m_format_nomor has parentMenu: 'Prefix'
          // So we check if /setup/m_prefix exists in user's menus
          if (!hasAccess && to.meta.parentMenu) {
            // Find the parent menu in user's menus by matching route names or paths
            const parentMenuName = to.meta.parentMenu as string
            
            // Try to find parent menu by checking if any menu path matches common patterns
            hasAccess = userMenus.some((menu: any) => {
              // Check if menu name matches parent menu name (case insensitive)
              if (menu.name && menu.name.toLowerCase().includes(parentMenuName.toLowerCase())) {
                return true
              }
              
              // For m_format_nomor → check if m_prefix menu exists
              // Extract base path from current route (e.g., /setup/m_format_nomor → /setup/m_prefix)
              const currentBasePath = to.path.split('/').slice(0, 3).join('/') // /setup/m_format_nomor
              const prefixPath = '/setup/m_prefix'
              
              // If current path starts with /setup/m_format_nomor and menu has /setup/m_prefix
              if (currentBasePath === '/setup/m_format_nomor' && menu.path === prefixPath) {
                return true
              }
              
              return false
            })
          }
          
          // Also check CHILD_ROUTE_MAPPING for child routes that inherit from parent menus
          if (!hasAccess) {
            const CHILD_ROUTE_MAPPING: Record<string, string> = {
              '/setup/m_format_nomor': '/setup/m_prefix',
              // Add more child route mappings here as needed
            }
            
            const basePath = '/' + to.path.split('/').slice(1, 3).join('/')
            const parentPath = CHILD_ROUTE_MAPPING[basePath]
            
            if (parentPath) {
              hasAccess = userMenus.some((menu: any) => {
                return menu.path === parentPath || to.path.startsWith(parentPath + '/')
              })
            }
          }
          
          if (!hasAccess) {
            // User doesn't have access to this route
            console.warn(`Access denied to route: ${to.path}`)
            next({ name: 'Dashboard' })
            return
          }
        } catch (e) {
          console.error('Error parsing SelectRespo:', e)
        }
      }
    }
    
    next()
  } else {
    next()
  }
})

// Update document title on route change
router.afterEach((to) => {
  const title = to.meta.title as string
  document.title = title ? `BB - ${title}` : 'BB - Bos Baut'
})

export default router

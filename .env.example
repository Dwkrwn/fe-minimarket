VITE_API_BASE_URL=https://server.qqltech.com:7135/api

# Supabase Function untuk notifikasi dokumen (/fn/notifikasi_controller/...).
# Production memakai host yang sama dengan VITE_API_BASE_URL; baris ini
# memudahkan lokal tetap mengarah ke Express untuk endpoint /v1/... .
VITE_NOTIFICATION_FUNCTIONS_BASE_URL=https://server.qqltech.com:7135/api

# Waktu timeout untuk AFK (Away From Keyboard) dalam milidetik
VITE_AFK_TIMEOUT_MS=3600000 #(1 jam)